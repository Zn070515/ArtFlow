# Copy this file to .env.event and replace every change-me value.
# Do not commit .env.event. The event launcher supplies host binding values.
APP_ENV=development
DEBUG=False
SECRET_KEY=change-me-with-a-random-event-secret
ADMIN_LOGIN_KEY=change-me-with-a-local-admin-login-key
ARTFLOW_ORGANIZATION_NAME=

DATABASE_ENGINE=postgresql
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=change-me-with-a-local-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
RATE_LIMIT_BACKEND=database
