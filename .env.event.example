# Copy this file to .env.event and replace every change-me value.
# Do not commit .env.event.
#
# The event launcher supplies three host-binding values and overrides anything written
# here, so they are named rather than templated — writing them in this file does nothing:
#   ARTFLOW_EVENT_BIND_ADDRESS    127.0.0.1, or 0.0.0.0 with -Lan
#   ARTFLOW_EVENT_PORT            8000, or whatever -Port selects
#   ARTFLOW_EVENT_ALLOWED_HOSTS   localhost and 127.0.0.1, plus the LAN address with -Lan
APP_ENV=development
DEBUG=False
SECRET_KEY=change-me-with-a-random-event-secret
QR_SIGNING_KEY=change-me-with-a-separate-event-qr-signing-key
STAFF_ACCESS_KEY=change-me-with-a-local-staff-access-key
ADMIN_ACCESS_KEY=change-me-with-a-local-admin-access-key
ARTFLOW_ORGANIZATION_NAME=
ARTFLOW_ICP_NUMBER=
ARTFLOW_ICP_URL=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Optional immutable commit SHA for application backup manifests.
ARTFLOW_RELEASE_SHA=

DATABASE_ENGINE=postgresql
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=change-me-with-a-local-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Seconds a worker may reuse one database connection before reconnecting. 60 is
# a conservative baseline; 0 disables reuse.
POSTGRES_CONN_MAX_AGE=60
RATE_LIMIT_BACKEND=database

# Optional runtime tuning. Every value below has a safe built-in default, so the event
# stack is valid without them; set one only to change the documented default. The event
# manifest forwards each of these to web, realtime and media, exactly like production.
# Formal activities reject performer-video direct uploads above this size (MiB).
ARTFLOW_VIDEO_UPLOAD_MAX_MB=100
# How media bytes leave the process once controlled_media has authorized them. Only
# "local" ships today; any other value is a startup error, not a silent fallback.
ARTFLOW_DELIVERY_BACKEND=local
# Per-registration upload budget (MiB), counted across everything the owner holds.
ARTFLOW_UPLOAD_QUOTA_MB=512
# Versions kept per file slot; older ones are deleted with their stored object.
ARTFLOW_UPLOAD_MAX_VERSIONS=5
# Refuse an upload when the media volume has less than this much free (MiB).
ARTFLOW_UPLOAD_MIN_FREE_MB=256
# Per-actor upload throttle: this many uploads per window.
ARTFLOW_UPLOAD_RATE_LIMIT=10
ARTFLOW_UPLOAD_RATE_WINDOW_SECONDS=3600
# Days a retained personal-information record is kept before purge_retained_pii may
# remove it.
ARTFLOW_PII_RETENTION_DAYS=365
# Process-local cache TTL for the public live-state snapshot (seconds).
LIVE_STATE_CACHE_SECONDS=1
# Seconds an admin's elevated second-factor verification stays valid before
# ADMIN_ACCESS_KEY must be re-entered on a sensitive action.
ADMIN_VERIFICATION_TTL_SECONDS=900
# Seconds an audience ticket session stays valid after a successful scan. The raw
# token lives only in the browser's HttpOnly cookie, never in the database.
TICKET_ACCESS_SESSION_TTL_SECONDS=28800

# Base image for the event stack's reverse proxy. Pinned to a tag by default because this
# profile is loopback/LAN only and never replaces the production topology; pin a digest
# here if the machine must run a verified immutable image.
ARTFLOW_CADDY_IMAGE=caddy:2-alpine
