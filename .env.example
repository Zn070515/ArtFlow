# Copy this file to .env and replace every change-me value. Do not commit .env.
APP_ENV=development
SECRET_KEY=change-me-with-a-local-development-secret
ADMIN_LOGIN_KEY=change-me-with-a-local-admin-login-key
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=change-me-with-a-local-admin-password
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Development and test use SQLite unless DATABASE_ENGINE is explicitly changed.
DATABASE_ENGINE=sqlite

# Set DATABASE_ENGINE=postgresql before using these local PostgreSQL settings.
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=change-me-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
