# Copy this file to .env and replace every change-me value. Do not commit .env.
APP_ENV=development
SECRET_KEY=change-me-with-a-local-development-secret
QR_SIGNING_KEY=change-me-with-a-separate-qr-signing-key
STAFF_ACCESS_KEY=change-me-with-a-local-staff-access-key
ADMIN_ACCESS_KEY=change-me-with-a-local-admin-access-key
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=change-me-with-a-local-admin-password
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional display branding for the purchaser or event organizer. This value
# is presentation-only and is never used for authorization, tenancy, or rules.
ARTFLOW_ORGANIZATION_NAME=

# Optional one-time bootstrap username for provision_first_admin. Never store
# the corresponding password in an environment template or command argument.
ARTFLOW_INITIAL_ADMIN_USERNAME=

# Development and test use SQLite unless DATABASE_ENGINE is explicitly changed.
DATABASE_ENGINE=sqlite

# Optional realtime transport for a local ASGI process. Leave blank to use the
# process-local development/test channel layer; production Compose supplies a
# private Redis URL to the dedicated realtime service.
ARTFLOW_REALTIME_REDIS_URL=

# Formal activities reject video direct-uploads above this size (MiB). Set to 0
# to ban any performer-video direct-upload; test-mode activities keep the large
# developer cap regardless.
ARTFLOW_VIDEO_UPLOAD_MAX_MB=100

# After this many seconds an admin's elevated second-factor verification expires
# and the admin must re-enter ADMIN_ACCESS_KEY on sensitive actions.
ADMIN_VERIFICATION_TTL_SECONDS=900

# How media bytes leave the process once controlled_media has authorized them. Only
# "local" ships today (the web worker streams the file); any other value is a startup
# error rather than a silent fallback.
ARTFLOW_DELIVERY_BACKEND=local

# Per-registration upload budget (MiB), counted across everything the owner holds rather
# than per file slot, so one extra question cannot multiply the disk ceiling.
ARTFLOW_UPLOAD_QUOTA_MB=512

# How many versions of a single file slot are kept; older ones are deleted with their
# stored object.
ARTFLOW_UPLOAD_MAX_VERSIONS=5

# Uploads are refused outright when the media volume has less than this much free (MiB).
ARTFLOW_UPLOAD_MIN_FREE_MB=256

# Per-actor upload throttle: this many uploads per ARTFLOW_UPLOAD_RATE_WINDOW_SECONDS.
ARTFLOW_UPLOAD_RATE_LIMIT=10
ARTFLOW_UPLOAD_RATE_WINDOW_SECONDS=3600

# Days a retained personal-information record is kept before purge_retained_pii may
# remove it.
ARTFLOW_PII_RETENTION_DAYS=365

# Process-local cache TTL for the public live-state snapshot (seconds). A lower value
# makes the audience page follow the current vote session more closely, at more DB load.
LIVE_STATE_CACHE_SECONDS=1

# Set DATABASE_ENGINE=postgresql before using these local PostgreSQL settings.
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=change-me-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
