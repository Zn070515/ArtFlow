# Copy this file to .env and replace every change-me value. Do not commit .env.
APP_ENV=development
SECRET_KEY=change-me-with-a-local-development-secret
ADMIN_LOGIN_KEY=change-me-with-a-local-admin-login-key
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=change-me-with-a-local-admin-password
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional display branding for the purchaser or event organizer. This value
# is presentation-only and is never used for authorization, tenancy, or rules.
ARTFLOW_ORGANIZATION_NAME=

# Development and test use SQLite unless DATABASE_ENGINE is explicitly changed.
DATABASE_ENGINE=sqlite

# Formal activities reject video direct-uploads above this size (MiB). Set to 0
# to ban any performer-video direct-upload; test-mode activities keep the large
# developer cap regardless.
ARTFLOW_VIDEO_UPLOAD_MAX_MB=100

# After this many seconds an admin's elevated second-factor verification expires
# and the admin must re-enter ADMIN_LOGIN_KEY on sensitive actions.
ADMIN_VERIFICATION_TTL_SECONDS=900

# Set DATABASE_ENGINE=postgresql before using these local PostgreSQL settings.
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=change-me-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
