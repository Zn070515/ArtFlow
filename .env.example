# ArtFlow-Plus local development. Copy to .env only if your shell does not
# already export these values; the defaults below match the dev container.
ARTFLOW_PLUS_DATABASE_URL=postgresql://artflow:artflow_dev@127.0.0.1:5433/artflow_plus
# Optional schema override for isolated tests or a shared local database.
ARTFLOW_PLUS_DB_SCHEMA=
ARTFLOW_PLUS_CREDENTIAL_SECRET=artflow-plus-development-secret
ARTFLOW_PLUS_ARCHIVE_DIR=
ARTFLOW_PLUS_MEDIA_DIR=
# Run the outbox relay inside the API process for single-process dev/E2E.
ARTFLOW_PLUS_INLINE_RELAY=1
# Vite proxy target for the web dev server.
VITE_API_TARGET=http://127.0.0.1:3000
