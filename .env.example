APP_ENV=development
SECRET_KEY=django-insecure-dev-only-change-me
ADMIN_LOGIN_KEY=change-me-local-admin-login-key
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=change-me-local-admin-password
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Development and test use SQLite unless DATABASE_ENGINE is explicitly changed.
DATABASE_ENGINE=sqlite
