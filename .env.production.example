# ArtFlow-Plus production manifest. Copy to .env.production and replace every
# replace-me value. Every image must be pinned by a verified manifest digest.
ARTFLOW_RELEASE_SHA=replace-me-with-the-deployed-commit-sha

ARTFLOW_POSTGRES_IMAGE=postgres:18-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_CADDY_IMAGE=caddy:2-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_API_IMAGE=ghcr.io/replace-me/artflow-plus-api@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_WORKER_IMAGE=ghcr.io/replace-me/artflow-plus-worker@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_WEB_IMAGE=ghcr.io/replace-me/artflow-plus-web@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_EXPORT_IMAGE=ghcr.io/replace-me/artflow-plus-export@sha256:replace-me-with-the-verified-digest

# Public DNS name used by Caddy for automatic TLS.
CADDY_SITE_ADDRESS=artflow.example.com

# Plus database. The compose service is plus-db.
PLUS_POSTGRES_DB=artflow_plus
PLUS_POSTGRES_USER=artflow_plus
PLUS_POSTGRES_PASSWORD=set-a-strong-plus-database-password

# HMAC key for capabilities and session material. 32+ random bytes; never reuse
# a database password or an old v1 secret.
ARTFLOW_PLUS_CREDENTIAL_SECRET=set-a-long-random-plus-credential-secret

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For to Plus.
# Compose pins its networks under 172.28.0.0/16 and the chain is Caddy -> nginx
# -> API, so both hops must be trusted. Leaving this empty makes request.ip the
# nginx container address and collapses every public visitor into one bucket.
ARTFLOW_PLUS_TRUST_PROXY=172.28.0.0/16

# Public rate limiting. Browsers send a stable per-browser id, so the per-visitor
# limits are the normal budget; this multiplier is the per-IP abuse ceiling for
# state-changing requests (venue NAT must fit below it).
ARTFLOW_PLUS_PUBLIC_IP_CEILING_MULTIPLIER=200

# Database pool and server-side guard rails. The migration pool disables both
# timeouts so a legitimate index build is not cancelled.
ARTFLOW_PLUS_DB_POOL_MAX=20
ARTFLOW_PLUS_DB_CONNECT_TIMEOUT_MS=10000
ARTFLOW_PLUS_DB_STATEMENT_TIMEOUT_MS=30000
ARTFLOW_PLUS_DB_LOCK_TIMEOUT_MS=15000

# API log level and optional Prometheus scrape token. /metrics is disabled
# unless the token is set; scrapers send it as X-Artflow-Metrics-Token.
ARTFLOW_PLUS_LOG_LEVEL=info
ARTFLOW_PLUS_METRICS_TOKEN=

# Persistent Plus material bytes and archive packages.
ARTFLOW_PLUS_ARCHIVE_DIR=/app/var/archives
ARTFLOW_PLUS_MEDIA_DIR=/app/var/media

# Worker relay cadence and shutdown drain bound. The ready file backs the
# compose healthcheck; leave these at their defaults unless tuning is required.
ARTFLOW_PLUS_WORKER_RELAY_INTERVAL_MS=250
ARTFLOW_PLUS_WORKER_SHUTDOWN_TIMEOUT_MS=10000
ARTFLOW_PLUS_WORKER_READY_FILE=/tmp/artflow-worker-ready

# Controlled DOCX/XLSX renderer. The sidecar is optional: set both values and
# start compose with `--profile export` to enable Word/Excel. Empty values keep
# CSV-only exports, and the API rejects a half-configured pair at startup.
ARTFLOW_PLUS_EXPORT_SERVICE_URL=
ARTFLOW_PLUS_EXPORT_TOKEN=

# DNS resolver used by the web image's /api proxy. Compose keeps the Docker
# embedded resolver; Kubernetes overrides it with the cluster DNS address.
ARTFLOW_NGINX_RESOLVER=127.0.0.11
# Upstream the web image proxies /api to. Compose uses the service name;
# Kubernetes uses the fully-qualified service name including the namespace.
ARTFLOW_NGINX_API_HOST=plus-api:3000

# Storage. "local" keeps the two volumes; "s3" moves material and archive
# objects to any S3-compatible endpoint (AWS S3, MinIO, Aliyun OSS S3 gateway).
ARTFLOW_PLUS_STORAGE_DRIVER=local
ARTFLOW_PLUS_S3_BUCKET=
ARTFLOW_PLUS_S3_REGION=us-east-1
ARTFLOW_PLUS_S3_ENDPOINT=
ARTFLOW_PLUS_S3_FORCE_PATH_STYLE=0
ARTFLOW_PLUS_S3_ACCESS_KEY_ID=
ARTFLOW_PLUS_S3_SECRET_ACCESS_KEY=
ARTFLOW_PLUS_S3_MEDIA_PREFIX=media
ARTFLOW_PLUS_S3_ARCHIVE_PREFIX=archives

# Password reset and single sign-on. Email reset is disabled until both SMTP
# values are present; OIDC is disabled until issuer/client/redirect are set.
ARTFLOW_PLUS_APP_BASE_URL=https://artflow.example.com
ARTFLOW_PLUS_SMTP_URL=
ARTFLOW_PLUS_MAIL_FROM=
# Send registration/schedule/result emails from the worker when SMTP is set.
ARTFLOW_PLUS_EMAIL_NOTIFICATIONS=0
ARTFLOW_PLUS_OIDC_ISSUER=
ARTFLOW_PLUS_OIDC_CLIENT_ID=
ARTFLOW_PLUS_OIDC_CLIENT_SECRET=
ARTFLOW_PLUS_OIDC_REDIRECT_URI=https://artflow.example.com/api/auth/oidc/callback
ARTFLOW_PLUS_OIDC_SCOPES=openid email profile
ARTFLOW_PLUS_OIDC_CLIENT_AUTH=post
ARTFLOW_PLUS_OIDC_AUTO_PROVISION=0
ARTFLOW_PLUS_OIDC_LABEL=统一身份登录
