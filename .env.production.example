# ArtFlow-Plus production manifest. Copy to .env.production and replace every
# replace-me value. Every image must be pinned by a verified manifest digest.
ARTFLOW_RELEASE_SHA=replace-me-with-the-deployed-commit-sha

ARTFLOW_POSTGRES_IMAGE=postgres:18-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_CADDY_IMAGE=caddy:2-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_API_IMAGE=ghcr.io/replace-me/artflow-plus-api@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_WORKER_IMAGE=ghcr.io/replace-me/artflow-plus-worker@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_WEB_IMAGE=ghcr.io/replace-me/artflow-plus-web@sha256:replace-me-with-the-verified-digest
ARTFLOW_PLUS_EXPORT_IMAGE=ghcr.io/replace-me/artflow-plus-export@sha256:replace-me-with-the-verified-digest

# Public DNS name used by Caddy for automatic TLS.
CADDY_SITE_ADDRESS=artflow.example.com

# Plus database. The compose service is plus-db.
PLUS_POSTGRES_DB=artflow_plus
PLUS_POSTGRES_USER=artflow_plus
PLUS_POSTGRES_PASSWORD=set-a-strong-plus-database-password

# HMAC key for capabilities and session material. 32+ random bytes; never reuse
# a database password or an old v1 secret.
ARTFLOW_PLUS_CREDENTIAL_SECRET=set-a-long-random-plus-credential-secret

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For to Plus.
# Leave empty unless the immediate reverse proxy is on a trusted internal network.
ARTFLOW_PLUS_TRUST_PROXY=

# Persistent Plus material bytes and archive packages.
ARTFLOW_PLUS_ARCHIVE_DIR=/app/var/archives
ARTFLOW_PLUS_MEDIA_DIR=/app/var/media

# Worker relay cadence and shutdown drain bound. The ready file backs the
# compose healthcheck; leave these at their defaults unless tuning is required.
ARTFLOW_PLUS_WORKER_RELAY_INTERVAL_MS=250
ARTFLOW_PLUS_WORKER_SHUTDOWN_TIMEOUT_MS=10000
ARTFLOW_PLUS_WORKER_READY_FILE=/tmp/artflow-worker-ready

# Controlled DOCX/XLSX renderer. The sidecar is on the internal network only;
# leave the token empty to keep CSV-only exports.
ARTFLOW_PLUS_EXPORT_SERVICE_URL=http://plus-export:8080
ARTFLOW_PLUS_EXPORT_TOKEN=set-a-long-random-export-token

# DNS resolver used by the web image's /api proxy. Compose keeps the Docker
# embedded resolver; Kubernetes overrides it with the cluster DNS address.
ARTFLOW_NGINX_RESOLVER=127.0.0.11
# Upstream the web image proxies /api to. Compose uses the service name;
# Kubernetes uses the fully-qualified service name including the namespace.
ARTFLOW_NGINX_API_HOST=plus-api:3000
