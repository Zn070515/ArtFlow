APP_ENV=production
DEBUG=False
SECRET_KEY=set-a-long-random-production-secret
ADMIN_LOGIN_KEY=set-a-long-random-admin-login-key
ARTFLOW_ORGANIZATION_NAME=
# Optional: leave blank until an actual filing exists; never use a sample number.
ARTFLOW_ICP_NUMBER=
ARTFLOW_ICP_URL=
# Full commit SHA of the source used to build the deployed image.
ARTFLOW_RELEASE_SHA=replace-me-with-the-deployed-commit-sha
# Every production image must use a verified immutable manifest digest.
ARTFLOW_PYTHON_IMAGE=python:3.12-slim@sha256:replace-me-with-the-verified-digest
ARTFLOW_POSTGRES_IMAGE=postgres:16-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_CADDY_IMAGE=caddy:2-alpine@sha256:replace-me-with-the-verified-digest
ALLOWED_HOSTS=artflow.example.com
CSRF_TRUSTED_ORIGINS=https://artflow.example.com

# Start with a short max-age and enable subdomains/preload only after every
# HTTPS subdomain is verified. Increase these values in a controlled rollout.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Public DNS name used by the production Caddy proxy for automatic TLS.
CADDY_SITE_ADDRESS=artflow.example.com

# The production manifest fixes this to true because Caddy is the trusted
# proxy and overwrites client-supplied X-Forwarded-For values.
TRUST_X_FORWARDED_FOR=true

DATABASE_ENGINE=postgresql
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=set-a-strong-database-password
# The production manifest fixes this to the Compose service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432
