APP_ENV=production
DEBUG=False
SECRET_KEY=set-a-long-random-production-secret
ADMIN_LOGIN_KEY=set-a-long-random-admin-login-key
ALLOWED_HOSTS=artflow.example.com
CSRF_TRUSTED_ORIGINS=https://artflow.example.com

# Only true when a trusted reverse proxy overwrites client-supplied
# X-Forwarded-For. Otherwise the app uses REMOTE_ADDR to avoid IP spoofing.
# See docs/deployment-production.md.
TRUST_X_FORWARDED_FOR=false

DATABASE_ENGINE=postgresql
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=set-a-strong-database-password
POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
