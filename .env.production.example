APP_ENV=production
DEBUG=False
SECRET_KEY=set-a-long-random-production-secret
# Separate secret for ticket QR credential signatures. Required by the production
# manifest (`QR_SIGNING_KEY:?`) and by config.runtime, which refuses to start when it
# is empty or still a placeholder. Never reuse SECRET_KEY here.
QR_SIGNING_KEY=set-a-long-random-qr-signing-key
STAFF_ACCESS_KEY=set-a-long-random-staff-access-key
ADMIN_ACCESS_KEY=set-a-long-random-admin-access-key
ARTFLOW_ORGANIZATION_NAME=
# Optional: leave blank until an actual filing exists; never use a sample number.
ARTFLOW_ICP_NUMBER=
ARTFLOW_ICP_URL=
# Full commit SHA of the source used to build the deployed image.
ARTFLOW_RELEASE_SHA=replace-me-with-the-deployed-commit-sha
# Every production image must use a verified immutable manifest digest.
ARTFLOW_PYTHON_IMAGE=python:3.12-slim@sha256:replace-me-with-the-verified-digest
ARTFLOW_POSTGRES_IMAGE=postgres:16-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_REDIS_IMAGE=redis:7-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_CADDY_IMAGE=caddy:2-alpine@sha256:replace-me-with-the-verified-digest
ARTFLOW_WEB_IMAGE=artflow-web:replace-me-with-the-release-sha
ALLOWED_HOSTS=artflow.example.com
CSRF_TRUSTED_ORIGINS=https://artflow.example.com

# Start with a short max-age and enable subdomains/preload only after every
# HTTPS subdomain is verified. Increase these values in a controlled rollout.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Public DNS name used by the production Caddy proxy for automatic TLS.
CADDY_SITE_ADDRESS=artflow.example.com

# The production manifest fixes this to true because Caddy is the trusted
# proxy and overwrites client-supplied X-Forwarded-For values.
TRUST_X_FORWARDED_FOR=true

# Optional runtime tuning. Every value below has a safe built-in default, so the
# deployment is valid without them; set one only to change the documented default.
# Each one is forwarded to the app services by deploy/compose.production.yml, which
# sets `environment:` per service and does not use `env_file:`.

# Formal activities reject performer-video direct uploads above this size (MiB).
ARTFLOW_VIDEO_UPLOAD_MAX_MB=100

# How media bytes leave the process once controlled_media has authorized them. Only
# "local" ships today; any other value is a startup error, not a silent fallback.
ARTFLOW_DELIVERY_BACKEND=local

# Per-registration upload budget (MiB), counted across everything the owner holds.
ARTFLOW_UPLOAD_QUOTA_MB=512

# Seconds an audience ticket session stays valid after a successful scan. The raw
# token lives only in the browser's HttpOnly cookie, never in the database.
TICKET_ACCESS_SESSION_TTL_SECONDS=28800

# Seconds an admin's elevated second-factor verification stays valid before
# ADMIN_ACCESS_KEY must be re-entered on a sensitive action.
ADMIN_VERIFICATION_TTL_SECONDS=900
# Versions kept per file slot; older ones are deleted with their stored object.
ARTFLOW_UPLOAD_MAX_VERSIONS=5
# Refuse an upload when the media volume has less than this much free (MiB).
ARTFLOW_UPLOAD_MIN_FREE_MB=256
# Per-actor upload throttle: this many uploads per window.
ARTFLOW_UPLOAD_RATE_LIMIT=10
ARTFLOW_UPLOAD_RATE_WINDOW_SECONDS=3600

# Days a retained personal-information record is kept before purge_retained_pii may
# remove it.
ARTFLOW_PII_RETENTION_DAYS=365

# Process-local cache TTL for the public live-state snapshot (seconds).
LIVE_STATE_CACHE_SECONDS=1

DATABASE_ENGINE=postgresql
POSTGRES_DB=artflow
POSTGRES_USER=artflow
POSTGRES_PASSWORD=set-a-strong-database-password
# The production manifest fixes this to the Compose service name.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Seconds a worker may reuse one database connection before reconnecting. 60 is
# a conservative baseline for the three sync Gunicorn workers; 0 disables reuse.
POSTGRES_CONN_MAX_AGE=60
