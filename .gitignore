# Python gate tooling
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local environment files (tracked templates are explicit exceptions)
.env
.env.*
!.env.example
!.env.production.example

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
# pnpm 12 writes a package-manager lockfile at the root when invoked there.
/pnpm-lock.yaml

# ArtFlow-Plus build output
plus/packages/domain/dist/
# ArtFlow-Plus sealed archive packages and local volumes
plus/var/
plus/apps/api/var/
# Generated E2E seed handoff
plus/apps/web/.e2e-live.json
plus/apps/web/.e2e-attendance.json

# Generated contract graphs and impact reports
plus/.artifacts/

# Runtime artifacts
*.sqlite3
media/
backups/
logs/**
test-results/
.playwright-mcp/
*.log

docs/advices/**
docs/superpowers/**

# Kubernetes lab credentials and generated manifests
.kube/
deploy/k8s/overlays/*/secrets.env
