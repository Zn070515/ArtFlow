http://127.0.0.1:8081 {
	@health path /healthz/
	reverse_proxy @health web:8000 {
		header_up Host {$CADDY_SITE_ADDRESS}
		header_up X-Forwarded-Proto https
	}
}

https://{$CADDY_SITE_ADDRESS} {
	request_body {
		max_size 120MB
	}
	header -Server
	@realtime path /ws/*
	reverse_proxy @realtime realtime:8001 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
	# Authorized media bytes go to their own worker pool, so a slow download cannot
	# occupy the workers that answer scoring, voting and judge requests. Authorization is
	# unchanged; that service runs the same controlled_media view.
	@media path /media/*
	reverse_proxy @media media:8002 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
	reverse_proxy web:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
}
