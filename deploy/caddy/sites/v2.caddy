# ArtFlow-Plus site profile. The realtime socket is served by plus-api behind
# plus-web at /api/realtime; there is no separate media gateway, and media bytes
# remain in v1 rather than being exposed through the public v2 host.
http://127.0.0.1:8081 {
	@health path /healthz /healthz/ /readyz /readyz/
	reverse_proxy @health plus-web:8080 {
		header_up Host {$CADDY_SITE_ADDRESS}
		header_up X-Forwarded-Proto https
	}
}

https://{$CADDY_SITE_ADDRESS} {
	request_body {
		max_size 128MB
	}
	header -Server
	reverse_proxy plus-web:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
}
