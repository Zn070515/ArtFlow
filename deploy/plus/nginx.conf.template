server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 128m;

  # Resolve at request time so an API restart never leaves a stale upstream.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $plus_api plus-api:3000;

  # Caddy's health probe uses /healthz/; Fastify only registers the bare paths.
  location ~ ^/(healthz|readyz)/?$ {
    proxy_pass http://$plus_api/$1;
    proxy_set_header Host $host;
  }

  location /api/ {
    proxy_pass http://$plus_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    # WebSocket (/api/realtime) shares this location with plain HTTP requests;
    # the upgrade headers are ignored when no upgrade is requested. SSE has been
    # retired.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
}
