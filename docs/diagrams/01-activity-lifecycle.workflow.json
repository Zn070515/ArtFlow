  "cards": [
    {
      "dot": "cyan",
      "title": "阶段是单向闸门",
      "items": [
        "测试活动与正式活动共用同一阶段链路",
        "服务端拒绝跳过或逆向阶段",
        "归档从 RESULTS_PUBLISHED 继续，不回到 LIVE"
      ]
    },
    {
      "dot": "amber",
      "title": "规则先冻结，再运行",
      "items": [
        "问卷、赛段、投票配置先编译成版本快照",
        "现场只消费冻结版本",
        "已有确认结果的版本不能被静默重冻"
      ]
    },
    {
      "dot": "rose",
      "title": "HOLD 优先于公示",
      "items": [
        "解析异常、输入不完整或候选过期都会停在结果闸门",
        "只有 Admin 确认后的候选才能进入公示",
        "阻断处理必须留下审计线索"
      ]
    }
