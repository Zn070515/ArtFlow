  "cards": [
    {
      "dot": "cyan",
      "title": "四类角色，四条凭证边界",
      "items": [
        "Staff 推进现场状态",
        "Judge 只写自己的评分事实",
        "Audience 只消费自己的票据会话并投票",
        "Participant 负责表演与报名数据"
      ]
    },
    {
      "dot": "emerald",
      "title": "并行输入，统一锁定",
      "items": [
        "评委评分与 Audience 投票可以并行产生",
        "VoteSession 与评分事实分别保留来源",
        "关闭 / lock 后才进入解析"
      ]
    },
    {
      "dot": "rose",
      "title": "HOLD 不改变身份",
      "items": [
        "暂停时保留本轮评委组与上下文",
        "恢复后继续同一场景",
        "无法在线评分时使用 Staff proxy 或 paper DR，并标记来源"
      ]
    }
