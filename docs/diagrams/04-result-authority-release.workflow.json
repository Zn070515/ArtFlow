  "cards": [
    {
      "dot": "rose",
      "title": "候选与权威分离",
      "items": [
        "resolve 只产生 READY_TO_CONFIRM 候选",
        "StageResult CONFIRMED 才是赛段正式来源",
        "VoteSession 锁定本身不会生成 Award"
      ]
    },
    {
      "dot": "amber",
      "title": "stale 必须拒绝",
      "items": [
        "输入 fingerprint 或 result version 变化时不能沿用旧候选",
        "解锁后旧来源不再进入正式列表",
        "新输入必须重新 resolve 与确认"
      ]
    },
    {
      "dot": "cyan",
      "title": "输出是下游消费",
      "items": [
        "结果页和导出只消费已确认来源",
        "重复确认不重复物化 Award",
        "Public 只是结果输出端，不是操作角色"
      ]
