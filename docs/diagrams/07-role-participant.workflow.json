  "cards": [
    {
      "dot": "cyan",
      "title": "选手要做的事",
      "items": [
        "扫活动二维码 → 报名 → 按题填报",
        "材料按题目上传，停止输入即自动保存",
        "提交前补齐必填项，提交后进入审核"
      ]
    },
    {
      "dot": "amber",
      "title": "断网也不丢",
      "items": [
        "草稿同时写入浏览器本地存储",
        "重新打开页面会恢复未保存内容并重试",
        "同一题被队友改过时先提示，不静默覆盖"
      ]
    },
    {
      "dot": "emerald",
      "title": "分组合唱",
      "items": [
        "分组由外部抽签产生，本组材料共享",
        "任一当前成员都可提交本组材料",
        "补交窗口只放行工作人员退回的题目"
      ]
    },
    {
      "dot": "slate",
      "title": "选手不能做的事",
      "items": [
        "不能自选文件类型，用途由服务端按题目判定",
        "不能绕开审核直接改已提交内容",
        "不能自己推进轮次或提交评分 / 投票"
      ]
    }
  ]
