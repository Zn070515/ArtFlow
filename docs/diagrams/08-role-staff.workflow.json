  "cards": [
    {
      "dot": "cyan",
      "title": "值班六步",
      "items": [
        "登录 → 审核报名与材料 → 准备轮次 → 录分 → 现场推进 → 结果与收尾",
        "每一步都在服务器侧再判一次权限与锁定状态；模板隐藏不构成保护"
      ]
    },
    {
      "dot": "amber",
      "title": "异常先 HOLD",
      "items": [
        "暂停评委组 / 表演，不要在评分进行中改上下文",
        "评分终端不可用时走代录或纸面评分，来源与原因必填",
        "重复提交是安全的：同一命令只产生一条评分事实"
      ]
    },
    {
      "dot": "violet",
      "title": "现场设备与票券",
      "items": [
        "检票用工作人员手机摄像头，另有拍照与手工输入回退",
        "检票三态：检票成功 / 此前已检票 / 无效",
        "票据可重打；怀疑泄漏就重置凭证，旧会话一并失效"
      ]
    },
    {
      "dot": "rose",
      "title": "工作人员不能做的事",
      "items": [
        "不能核定正式结果、不能解锁活动 / 轮次 / 结果",
        "不能修改已核定赛段的评分事实",
        "不能替评委决定给谁打分：评分对象由服务器决定"
      ]
    }
  ]
