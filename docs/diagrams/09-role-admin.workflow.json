  "cards": [
    {
      "dot": "rose",
      "title": "只有管理员能做",
      "items": [
        "阶段推进、冻结赛制、核定结果、解锁、用户与角色",
        "敏感动作要过二次密钥，且验证窗口有时限",
        "解锁必须填原因；解锁后重新计算并重新核定"
      ]
    },
    {
      "dot": "cyan",
      "title": "建立权威的顺序",
      "items": [
        "活动 → 赛制（绑定并冻结）→ 彩排 → 清残留 → 转正式",
        "冻结用真实事实编译，缺绑定就冻结失败：这是刻意的",
        "赛制改版走后继版本，不就地改写已冻结的版本"
      ]
    },
    {
      "dot": "amber",
      "title": "彩排与正式不能混",
      "items": [
        "测试活动不对公众可见；离开测试模式前必须先清空运行时残留",
        "配置（问卷、赛制、材料槽）保留；运行事实（分数、票、结果）清零"
      ]
    },
    {
      "dot": "slate",
      "title": "发布边界与外部证据",
      "items": [
        "结果必须 CONFIRMED 才能发布公示；撤销公示会留痕并取代旧发布",
        "备案、真实 DNS / TLS、WAF / DDoS、学校 SSO 未齐前，公网发布保持 HOLD"
      ]
    }
  ]
