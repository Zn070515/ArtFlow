  "cards": [
    {
      "dot": "cyan",
      "title": "观众的六步",
      "items": [
        "拿到票 → 现场扫码 → 工作人员检票 → 打开投票入口 → 选人提交 → 投票成功",
        "检票后浏览器会记住票据资格，整场不需要反复扫码",
        "票据可以重打；怀疑二维码泄漏时由管理员重置凭证，旧码与旧会话同时失效"
      ]
    },
    {
      "dot": "emerald",
      "title": "投票资格从哪来",
      "items": [
        "有效票 + 已检票：两者缺一不可",
        "正式歌手比赛不用现场口令，凭证就是你的票",
        "被撤销的票立即失去资格，即使浏览器还留着 cookie"
      ]
    },
    {
      "dot": "violet",
      "title": "一张票一份选票",
      "items": [
        "唯一性是「票 + 场次」：同一张票可以在不同轮次各投一次",
        "共用一部手机的两位持票观众都能投",
        "不采集设备指纹、不做 IP 一票、不强制实名"
      ]
    },
    {
      "dot": "slate",
      "title": "窗口与结果",
      "items": [
        "只有开放中且在时间窗口内才能提交",
        "投票一经提交不可修改；结果由赛制按支持率换算",
        "公示结果与直播页是只读输出，观众不参与核定"
      ]
    }
  ]
