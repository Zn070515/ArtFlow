  "cards": [
    {
      "dot": "cyan",
      "title": "前端：9 个入口，一个构建",
      "items": [
        "公开端：直播页、票据验证、投票页",
        "选手与评委端：问卷与材料、评委终端、在线协作",
        "现场端：手机检票、快速录分、活动字段协作",
        "全部由 tsc 编译到 static/dist；npm run check:client 守住编译产物与源码一致"
      ]
    },
    {
      "dot": "violet",
      "title": "后端：按域拆分的 Django app",
      "items": [
        "账号与活动：accounts、core、common（权限、审计、生命周期、维护）",
        "赛制与问卷：ruleset、questionnaire（编译、冻结、解析、报名）",
        "比赛与材料：singer_contest、files（轮次、评委、评分、结果、材料检查项）",
        "观众侧：tickets、voting、entry_access（票券、选票、入口授权）",
        "运营与产物：staff_panel、exports、archive、incidents、realtime",
        "未列入的 docs / scripts / deploy 只服务构建与部署，不参与运行时"
      ]
    },
    {
      "dot": "amber",
      "title": "横切边界只有三条",
      "items": [
        "受控媒体：私有文件走受控视图按所有权判读权，不挂静态路由",
        "authority：写操作先取活动行锁，再按域显式授权（RULESET_FREEZE、STAGE_RESULT_RESOLVE…）",
        "审计：敏感操作、导出、解锁、事故登记全部留痕"
      ]
    },
    {
      "dot": "slate",
      "title": "数据与运行",
      "items": [
        "开发默认 SQLite，生产用 PostgreSQL，同一套迁移",
        "浏览器只与 Django 视图对话，没有直连数据层的路径",
        "导出（Excel / Word）与归档包都在服务器侧生成"
      ]
    }
  ]
}
