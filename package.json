{
  "name": "artflow-assets",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/src.css -o ./static/css/app.css --minify",
    "check:css": "npm run build:css && git diff --exit-code -- static/css/app.css",
    "build:client": "tsc -p tsconfig.client.json",
    "check:client": "npm run build:client && git diff --exit-code -- static/dist/",
    "test:client": "node --test tests/client/*.test.mjs",
    "test:e2e": "playwright test",
    "check:pyright": "uv run pyright"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@zxing/browser": "^0.1.5",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2"
  }
}
