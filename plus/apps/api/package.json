{
  "name": "@artflow-plus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs --external:pg-native",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "seed:e2e": "tsx scripts/seed-public-result.ts && tsx scripts/seed-registration.ts && tsx scripts/seed-live.ts && tsx scripts/seed-legacy.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@artflow-plus/contracts": "workspace:*",
    "@artflow-plus/db": "workspace:*",
    "@artflow-plus/domain": "workspace:*",
    "@artflow-plus/runtime": "workspace:*",
    "@fastify/swagger": "9.9.2",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.7",
    "kysely": "0.29.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
