{
  "name": "@artflow-plus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs --external:pg-native",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "ops": "tsx src/ops.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@artflow-plus/db": "workspace:*",
    "@artflow-plus/domain": "workspace:*",
    "@artflow-plus/runtime": "workspace:*",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
