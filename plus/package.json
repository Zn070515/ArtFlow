{
  "name": "artflow-plus",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:prod": "pnpm --filter @artflow-plus/web build && pnpm --filter @artflow-plus/api build:bundle && pnpm --filter @artflow-plus/worker build:bundle",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
