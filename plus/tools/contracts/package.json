{
  "name": "@artflow-plus/contract-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "graph": "pnpm run build && node dist/graph/cli.js graph",
    "graph:check": "pnpm run build && node dist/graph/cli.js graph --check --strict",
    "impact": "pnpm run build && node dist/graph/cli.js impact",
    "readiness": "tsx src/harness/readiness-cli.ts",
    "audit": "tsx src/audit/cli.ts",
    "audit:check": "tsx src/audit/cli.ts --check",
    "mutation:audit": "tsx src/audit/mutation-cli.ts"
  },
  "dependencies": {
    "@artflow-plus/contracts": "workspace:*",
    "@artflow-plus/db": "workspace:*",
    "@artflow-plus/domain": "workspace:*",
    "@artflow-plus/runtime": "workspace:*",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@sinclair/typebox": "0.34.52",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
